# Embedding model selection. Switch this value to compare models without code changes.
# Recommended backend. Set to local for offline/compatibility runs.
EMBEDDING_BACKEND=remote
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# Qwen3 has a built-in "query" prompt. Leave empty for models such as BGE-M3.
# EMBEDDING_QUERY_PROMPT_NAME=query

# Optional local model cache directory.
# EMBEDDING_CACHE_FOLDER=/path/to/model-cache

# Set true only for models whose SentenceTransformer implementation requires it.
EMBEDDING_TRUST_REMOTE_CODE=false

# Remote Qwen embedding backend. EMBEDDING_BACKEND=remote enables it.
EMBEDDING_REMOTE_URL=http://192.168.31.238:8002
EMBEDDING_REMOTE_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_REMOTE_TIMEOUT_SECONDS=30
EMBEDDING_REMOTE_DIMENSION=1024
EMBEDDING_REMOTE_MAX_MODEL_LEN=4096
EMBEDDING_REMOTE_BATCH_SIZE=32
# EMBEDDING_REMOTE_MODEL_REVISION=

# Milvus connection. Set MILVUS_COLLECTION to the name written in
# artifacts/chunks/pymupdf/v0/milvus_report.json after indexing.
MILVUS_URI=http://localhost:19530
# MILVUS_COLLECTION=rag_v0_qwen_qwen3_embedding_0_6b_800_120

# V1.1 built-in BM25 collection. Leave unset to use the documented default.
# BM25_MILVUS_COLLECTION=rag_v1_1_bm25_multilingual_800_120
# BM25_MILVUS_DROP_OLD=false

# V1.2-A reranker backend. Defaults to the frozen local implementation.
RERANK_BACKEND=local
# Set RERANK_BACKEND=remote to call a vLLM service over HTTP.
# RERANK_REMOTE_URL=http://192.168.31.238:8001
# RERANK_REMOTE_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_REMOTE_TIMEOUT_SECONDS=60

# Local BGE reranker. The default model is pinned to a reproducible snapshot.
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RERANK_DEVICE=cpu
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=512
RERANK_USE_FP16=false
RERANK_LOCAL_FILES_ONLY=false
# RERANK_CACHE_DIR=/path/to/model-cache

# Qwen generation through Alibaba Model Studio's OpenAI-compatible API.
# DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GENERATION_MODEL=qwen-plus
GENERATION_TEMPERATURE=0
GENERATION_MAX_TOKENS=1024
GENERATION_TIMEOUT=60
GENERATION_MAX_RETRIES=2
GENERATION_ENABLE_THINKING=false

# RAGAS Judge settings. MODEL and BASE_URL are required and are never inherited
# from GENERATION_*. If the evaluator key is omitted, the application reuses
# DASHSCOPE_API_KEY without copying it.
# RAGAS_EVALUATOR_API_KEY=your-api-key
RAGAS_EVALUATOR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAGAS_EVALUATOR_MODEL=qwen-plus
RAGAS_EVALUATOR_TEMPERATURE=0
RAGAS_EVALUATOR_MAX_TOKENS=4096
RAGAS_EVALUATOR_TIMEOUT=120
RAGAS_EVALUATOR_MAX_RETRIES=2
RAGAS_EVALUATOR_ENABLE_THINKING=false

# Local embedding used by Answer Relevancy and the semantic-similarity part of
# Answer Correctness. If omitted, the corresponding EMBEDDING_* value is used.
# RAGAS_EVALUATOR_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# RAGAS_EVALUATOR_EMBEDDING_DEVICE=cpu
# RAGAS_EVALUATOR_EMBEDDING_BATCH_SIZE=32
# RAGAS_EVALUATOR_EMBEDDING_NORMALIZE=true
# RAGAS_EVALUATOR_EMBEDDING_QUERY_PROMPT_NAME=query
# RAGAS_EVALUATOR_EMBEDDING_TRUST_REMOTE_CODE=false
